# Copy to .env.local (gitignored). Restart `pnpm dev` after editing.
# Browser login: username class. Required for pnpm start and all deployments.
# Leave empty only for local pnpm dev. Share privately, never in a URL or commit.
CLASS_PASSWORD=
OPENROUTER_API_KEY=
# The Claude model for /api/chat, as an OpenRouter id.
CHAT_MODEL=anthropic/claude-sonnet-5.5
# /keys (student keys, from apps/workshop-keys): a management key with an expiry, and the workshop's settings.
# Leave empty and /keys says it isn't set up here.
OPENROUTER_MANAGEMENT_KEY=
WORKSHOP_SLUG=
WORKSHOP_TITLE=
CLAIM_PASSWORD=
# Optional /keys settings (defaults: 40 students, six-hour keys).
MAX_KEYS=
KEY_TTL_HOURS=
# Optional: separately running Ensemble harness. Default is local port 3031.
ENSEMBLE_HARNESS_URL=
# /my-custom-chatbot submissions: server-only, never NEXT_PUBLIC_ variables.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=app7DoflsjxwhVdNl
AIRTABLE_TABLE_ID=tblV3bxxGlQvrsp8w
SUBMIT_ACTIVE=false
# Optional preview model override; a blank submitted model uses the Ensemble's default.
CUSTOM_CHATBOT_MODEL=
