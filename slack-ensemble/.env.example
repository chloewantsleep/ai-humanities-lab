# Copy to .env (gitignored) and fill in. Names only here; never commit values.

# From api.slack.com, after creating the app from slack-manifest.json (README, "Install in Slack").
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Optional: answer only in these channel IDs, comma-separated (e.g. C0123456789). Unset: any channel the app is in.
ENSEMBLE_CHANNELS=
# Optional: a channel ID where students post their bot files to join. A direct message to the app always works.
ENSEMBLE_SUBMIT_CHANNEL=

OPENROUTER_API_KEY=
# The model for bots that don't name one, or whose model is too expensive or not allowed. The same default as the
# course app's /bot-lab, so a bot sounds the same in both; anthropic/claude-haiku-5.5 costs a twentieth as much.
ENSEMBLE_DEFAULT_MODEL=anthropic/claude-sonnet-5.5
# Optional comma-separated allow-list of models.
ENSEMBLE_ALLOWED_MODELS=
# Bots whose model costs more than this (dollars per million output tokens) get the default model.
ENSEMBLE_MAX_OUTPUT_PRICE=10
# Includes any reasoning tokens, so keep it well above the length of a reply.
ENSEMBLE_MAX_TOKENS=1000
# low, medium, high, or default (send nothing)
ENSEMBLE_REASONING=low

# Loop guard and rate limits.
ENSEMBLE_MAX_BOT_CHAIN=3
ENSEMBLE_MAX_THREAD_BOT_TURNS=40
ENSEMBLE_MAX_RESPONDERS=3
ENSEMBLE_PER_BOT_PER_MINUTE=6
ENSEMBLE_PER_BOT_PER_HOUR=60
ENSEMBLE_CONTEXT_MESSAGES=30

# Where the bots are (default ../nextjs/bots), the logs (default logs/), and the local status/dry-run API port.
BOTS_DIR=
# false leaves the example bots in bots/_examples/ out of the room
ENSEMBLE_EXAMPLES=true
LOG_DIR=
ENSEMBLE_PORT=3031
